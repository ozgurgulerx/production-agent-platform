# Copy to `.env` at the track root and fill in your values. `.env` is gitignored.
# Authentication is Application Default Credentials only: `gcloud auth application-default login`. No API keys.

# Project and region. europe-west2 is supported for Agent Runtime, Sessions and Memory Bank (map A9).
GOOGLE_CLOUD_PROJECT=ga-gcp-learn
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_GENAI_USE_VERTEXAI=TRUE          # google-genai and ADK route to the platform, not AI Studio
GOOGLE_GENAI_USE_ENTERPRISE=TRUE        # map G9 names this one for endpoint-path models; which ADK 2.13 reads is unverified, so set both

# Models (map B10). The 2.5 family retired on 20 Oct 2026; do not use it.
GEMINI_MODEL=gemini-3.5-flash           # default for every lab
GEMINI_LITE_MODEL=gemini-3.5-flash-lite # G06 tuning base, cheap eval judge
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Agent Runtime (filled by G03 lab 02 after the first deploy; resource path form projects/P/locations/L/reasoningEngines/ID)
AGENT_RUNTIME_RESOURCE=
AGENT_RUNTIME_STAGING_BUCKET=           # gs://<bucket>; same region as GOOGLE_CLOUD_LOCATION
AGENT_SERVICE_ACCOUNT=                  # optional; unset means Agent Identity when identity_type=AGENT_IDENTITY

# Ticketing MCP server (G04 labs 02-05). Cloud Run URL of the MCP Toolbox deployment from G04 lab 03.
TICKET_MCP_URL=
TOOLBOX_SERVICE_ACCOUNT=toolbox-identity

# Apigee (G04 lab 04, G09). Leave empty to skip the gateway variant.
APIGEE_ORG=
APIGEE_MCP_URL=

# Knowledge (G03 lab 05, G08 lab 01)
AGENT_SEARCH_DATASTORE=                 # projects/P/locations/global/collections/default_collection/dataStores/ID
RAG_CORPUS=                             # projects/P/locations/L/ragCorpora/ID
POLICY_DOCS_BUCKET=                     # gs://<bucket> with the ticket policy PDFs

# Tuning (G06). Gemini 3.x tunes and serves on the us/eu multi-region only (map G2); bucket must be readable from there.
TUNING_LOCATION=eu
TUNING_BUCKET=                          # gs://<bucket>; may equal AGENT_RUNTIME_STAGING_BUCKET if the region allows

# Local (G07)
OLLAMA_API_BASE=http://localhost:11434
LOCAL_MODEL=ollama_chat/gemma4:e4b
