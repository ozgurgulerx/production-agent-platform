# Copy to `.env` at the track root and fill in your values. `.env` is gitignored.
# Authentication is IAM only: `aws sso login --profile <name>` (or an assumed role). No access keys in files.

AWS_REGION=us-east-1                     # Evaluations, Policy and Harness are in us-east-1 / us-west-2; stay in one of those
AWS_PROFILE=                             # the SSO profile from `aws configure sso`; leave empty to use the default chain

# Models (inference-profile ids, not bare model ids; labs-setup/01-models explains why)
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5   # default chat model for every lab
BEDROCK_JUDGE_MODEL_ID=global.anthropic.claude-sonnet-5-5   # custom evaluators (B05)
BEDROCK_FT_BASE_MODEL_ID=amazon.nova-2-lite-v1:0     # B06 fine-tuning base

# Account identifiers (filled once)
AWS_ACCOUNT_ID=
AGENTCORE_RUNTIME_ROLE_ARN=              # execution role trusted by bedrock-agentcore.amazonaws.com (labs-setup/00-setup creates it)
AGENTCORE_GATEWAY_ROLE_ARN=              # gateway role (B04 lab 03 creates it)
CODE_BUCKET=                             # S3 bucket for direct code deploy zips and datasets

# Written by the labs as resources appear (B03 01 → B04 → B05 → B09 read them)
TICKET_AGENT_RUNTIME_ARN=
TICKET_AGENT_HARNESS_ARN=
TICKET_MCP_RUNTIME_ARN=
TICKET_GATEWAY_URL=
TICKET_GATEWAY_ID=
TICKET_MEMORY_ID=
POLICY_ENGINE_ID=

# Cognito user pool for the JWT labs (B04 lab 01 creates it; also used by Gateway and Policy)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DISCOVERY_URL=                   # https://cognito-idp.<region>.amazonaws.com/<pool-id>/.well-known/openid-configuration
COGNITO_TEST_USERNAME=

# Also written by labs (no need to fill by hand)
# B03: TICKET_AGENT_CODE_S3_URI, TICKET_AGENT_CONTAINER_RUNTIME_ARN, TICKET_GRAPH_RUNTIME_ARN, TICKET_A2A_RUNTIME_ARN, TICKET_A2A_CARD_URL
# B04: TICKET_AGENT_JWT_ARN, TICKET_MCP_URL, TICKET_TOOLS_LAMBDA_ARN, TICKETS_LAMBDA_TARGET_ID, TICKETS_API_TARGET_ID, TICKETS_API_KEY_PROVIDER_ARN,
#      TICKETS_OAUTH_PROVIDER_ARN, ENTRA_OBO_PROVIDER_ARN, TICKET_REGISTRY_ID/ARN, TICKET_AGENT_TARGET_ID, REFUND_A2A_TARGET_ID, TICKET_CANARY_RULE_ID,
#      COGNITO_CLIENT_SECRET, COGNITO_DOMAIN, COGNITO_TEST_PASSWORD
# B05: GUARDRAIL_ID, GUARDRAIL_VERSION, ONLINE_EVAL_CONFIG_ID        B09: POLICY_ENGINE_ARN
# B08: TICKET_KB_ID, TICKET_KB_TARGET_ID        B06: FT_ROLE_ARN, FT_JOB_ARN, FT_CUSTOM_MODEL_ARN, FT_DEPLOYMENT_ARN
# Optional inputs for B04 lab 04 rows you have credentials for: TICKETS_API_BASE, TICKETS_API_KEY, OAUTH_DISCOVERY_URL, OAUTH_CLIENT_ID,
#      OAUTH_CLIENT_SECRET, OAUTH_3LO_PROVIDER, ENTRA_TENANT_ID, ENTRA_CLIENT_ID, ENTRA_CLIENT_SECRET; B05: AGENTCORE_EVAL_ROLE_ARN, BEDROCK_SERVICE_TIER
# Optional for B07 local: OLLAMA_HOST, LLAMACPP_URL; B03 openai-agents variant: OPENAI_MODEL; B08: KB_CONNECTOR_ID (verify the connector id in your region)
