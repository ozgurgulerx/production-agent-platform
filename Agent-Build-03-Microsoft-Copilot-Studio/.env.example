# Copy to `.env` at the track root and fill in your values. `.env` is gitignored.
# Authentication is Entra only: device-code sign-in through a public-client app registration (no client secrets in files).

TENANT_ID=
CLIENT_ID=                               # public-client app registration (labs-setup/00-setup/README.md §3): delegated CopilotStudio.Copilots.Invoke, Dynamics CRM user_impersonation, Graph Application.Read.All
ENVIRONMENT_ID=                          # Power Platform environment id (GUID), a Managed Environment
ENVIRONMENT_URL=                         # Dataverse org URL, e.g. https://org12345.crm11.dynamics.com (UK = crm11)
POWER_PLATFORM_API=https://api.powerplatform.com
POWER_PLATFORM_CLOUD=Prod                # Prod | Gov | High | DoD | Mooncake (Direct-to-Engine ConnectionSettings)

# The ticket agent (Standard harness). Schema name appears in Settings > Advanced > Metadata after the first save.
AGENT_SCHEMA_NAME=                       # e.g. cr1ab_ticketAgent
AGENT_ID=                                # bot id (GUID) from Dataverse, written by C03 lab 01

# Tools and knowledge
TICKET_MCP_URL=                          # HTTPS Streamable-HTTP endpoint of the ticket MCP server (C04 lab 02); reuse the Foundry/AWS track deployment or a tunnel
TICKET_API_BASE=                         # REST tool base URL (C04 lab 03)
SHAREPOINT_SITE_URL=                     # knowledge site for the three policy documents (C08)
FOUNDRY_KB_NAME=                         # Foundry IQ knowledge base from the F08 lab, optional (C08)

# Observability
APPINSIGHTS_CONNECTION_STRING=           # agent-level and environment-level telemetry (C05 lab 02)

# Written by labs (no need to fill by hand): TESTSET_ID, TESTRUN_ID (C05), AGENT_ENTRA_OBJECT_ID (C04), BYO_PROTECTION_URL (C05)

# Optional inputs some labs read (leave empty unless the lab README asks):
# C03: AGENT_DISPLAY_NAME, DIRECTLINE_TOKEN_ENDPOINT (Channels → Mobile app), CS_A2A_CARD_URL (lab 02, the agent published as A2A)
#      SDK agent (lab 04) env: CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE / CLIENTID / TENANTID / FEDERATEDCLIENTID, PORT, REFUND_LIMIT_GBP
# C04: TICKET_MCP_API_KEY (lab 02 API-key mode), TICKET_API_KEY (lab 03 REST tool), FOUNDRY_PROJECT_ENDPOINT + FOUNDRY_AGENT_NAME (lab 04, or the Foundry track .env),
#      WEBAPP_CLIENT_ID + WEBAPP_CERT_PATH + WEBAPP_CERT_THUMBPRINT (lab 05 OBO with a certificate, never a secret)
# C06: FOUNDRY_PROMPT_DEPLOYMENT (BYO chat-completions deployment behind a Prompt tool)
