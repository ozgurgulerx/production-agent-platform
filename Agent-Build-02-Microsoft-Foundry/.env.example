# Copy to `.env` at the repo root and fill in your values. `.env` is gitignored.
# Authentication is Entra only: run `az login` (and `azd auth login`). No API keys.

# Foundry project endpoint: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Model deployments in that project (created by labs-setup/01-models/deploy_models.sh; values are DEPLOYMENT names)
FOUNDRY_MODEL=gpt-5-mini                 # default chat model for every demo
FOUNDRY_REASONING_MODEL=gpt-5-mini       # reasoning-effort demo (01/04)
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small   # 04 memory
FOUNDRY_VOICE_MODEL=gpt-realtime         # 01/03 voice prompt agent (preview)

# Azure resource identifiers (03 Entra Agent ID, 02 container deploy, 13 evals CI)
AZ_SUBSCRIPTION_ID=
AZ_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
ACR_NAME=                                # only for 02/container-deploy

# Azure AI Search: F03 lab 05 (tool) and F08 lab 01 (knowledge base)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZ_STORAGE_ACCOUNT=                      # F08 lab 01: policy documents container

# Optional: remote MCP servers for F04 labs 02-05 (leave empty to use the public demo server)
LOGIC_APP_MCP_URL=
APIM_MCP_URL=
